{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "paths" :{
    "@pages/*" : ["./src/pages/*"],
    "@fixtures/*" : ["./src/fixtures/*"],
    "@utils/*" : ["./src/utils/*"],
  },
  "include": ["src/**/*", "tests/**/*", "playwright.config.ts"]
}
